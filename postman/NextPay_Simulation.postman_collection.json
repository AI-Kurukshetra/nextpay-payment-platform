            "body": { "mode": "raw", "raw": "{\n  \"amount\": 13000,\n  \"currency\": \"USD\",\n  \"routingMode\": \"manual\",\n  \"routeType\": \"bank\",\n  \"preferredProcessor\": \"bank_gateway\",\n  \"metadata\": {\"source\": \"postman\"}\n}" },
            "url": "{{baseUrl}}/payments"
          }
        },
