          "name": "List Payments (Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/payments?status=succeeded&currency=USD"
          }
        }
      ]
