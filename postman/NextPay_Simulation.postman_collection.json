    {
      "name": "3DS",
      "item": [
        {
          "name": "Create Payment (Require 3DS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 9000,\n  \"currency\": \"USD\",\n  \"require3ds\": true,\n  \"metadata\": {\"flow\": \"3ds_test\"}\n}" },
            "url": "{{baseUrl}}/payments"
