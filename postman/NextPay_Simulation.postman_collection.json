            "body": { "mode": "raw", "raw": "{\n  \"challengeResult\": \"authenticated\",\n  \"eci\": \"05\",\n  \"dsTransactionId\": \"ds_1234567890\"\n}" },
            "url": "{{baseUrl}}/payments/{{paymentId}}/3ds/authenticate"
          }
        }
