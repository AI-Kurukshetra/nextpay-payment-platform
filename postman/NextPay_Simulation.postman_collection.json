              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"returnUrl\": \"http://localhost:3000/overview\",\n  \"deviceChannel\": \"browser\"\n}" },
            "url": "{{baseUrl}}/payments/{{paymentId}}/3ds/initiate"
